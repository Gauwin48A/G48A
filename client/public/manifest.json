{
  "name": "MHub Marketplace",
  "short_name": "MHub",
  "description": "Premium verified marketplace for buying and selling products with trust-first listings and local discovery",
  "start_url": "/?source=pwa",
  "id": "/",
  "scope": "/",
  "display": "standalone",
  "display_override": ["window-controls-overlay", "standalone", "minimal-ui"],
  "background_color": "#ffffff",
  "theme_color": "#2563eb",
  "orientation": "portrait-primary",
  "icons": [
    {
      "src": "/pwa-192x192.png",
      "sizes": "192x192",
      "type": "image/png",
      "purpose": "any maskable"
    },
    {
      "src": "/pwa-512x512.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "any maskable"
    }
  ],
  "categories": [
    "shopping",
    "business",
    "lifestyle"
  ],
  "shortcuts": [
    {
      "name": "Browse Listings",
      "short_name": "Browse",
      "description": "Explore all marketplace listings",
      "url": "/all-posts?source=shortcut",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Sell an Item",
      "short_name": "Sell",
      "description": "Create a new listing",
      "url": "/add-post?source=shortcut",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "My Rewards",
      "short_name": "Rewards",
      "description": "Check your rewards and referrals",
      "url": "/rewards?source=shortcut",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192", "type": "image/png" }]
    },
    {
      "name": "Messages",
      "short_name": "Chat",
      "description": "View your conversations",
      "url": "/chat?source=shortcut",
      "icons": [{ "src": "/pwa-192x192.png", "sizes": "192x192", "type": "image/png" }]
    }
  ],
  "prefer_related_applications": false,
  "handle_links": "preferred",
  "launch_handler": {
    "client_mode": "navigate-existing"
  },
  "share_target": {
    "action": "/add-post",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "description",
      "url": "url"
    }
  },
  "screenshots": [],
  "related_applications": []
}
