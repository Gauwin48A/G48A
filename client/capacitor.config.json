{
  "appId": "com.mhub.app",
  "appName": "MHub",
  "webDir": "dist",
  "android": {
    "loggingBehavior": "debug",
    "webContentsDebuggingEnabled": true
  },
  "server": {
    "androidScheme": "http",
    "cleartext": true,
    "allowNavigation": ["10.0.2.2", "localhost"]
  },
  "plugins": {
    "App": {
      "appUrlScheme": "mhub"
    },
    "StatusBar": {
      "backgroundColor": "#2563eb",
      "style": "LIGHT",
      "overlaysWebView": false
    }
  }
}
