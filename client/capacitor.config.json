{
  "appId": "com.mhub.app",
  "appName": "MHub",
  "webDir": "dist",
  "android": {
    "loggingBehavior": "none",
    "webContentsDebuggingEnabled": false
  },
  "server": {
    "androidScheme": "https",
    "cleartext": false,
    "allowNavigation": ["api.mhub.app"]
  },
  "plugins": {
    "App": {
      "appUrlScheme": "mhub"
    },
    "StatusBar": {
      "backgroundColor": "#2563eb",
      "style": "LIGHT",
      "overlaysWebView": false
    }
  }
}
