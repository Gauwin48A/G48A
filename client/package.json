{
  "name": "client",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "node scripts/dev-safe.mjs",
    "dev:fresh": "node scripts/dev-safe.mjs --fresh",
    "build": "vite build",
    "check:bundle-budget": "node scripts/check-bundle-budget.mjs",
    "check:performance-budget": "node scripts/check-performance-budget.mjs",
    "check:no-hardcoded-localhost": "node scripts/check-no-hardcoded-localhost.mjs",
    "check:network-contract": "node scripts/check-network-contract.mjs",
    "check:ux-smoke": "node scripts/check-ux-route-smoke.mjs",
    "check:structure": "node scripts/check-folder-structure.mjs",
    "test:e2e:smoke": "npx playwright test -c playwright.config.mjs --project=smoke",
    "test:e2e:smoke:headed": "npx playwright test -c playwright.config.mjs --project=smoke --headed",
    "test:e2e:comprehensive": "npx playwright test -c playwright.config.mjs --project=comprehensive --workers=4",
    "test:e2e:comprehensive:headed": "npx playwright test -c playwright.config.mjs --project=comprehensive --headed --workers=2",
    "test:e2e:visual": "npx playwright test -c playwright.config.mjs --project=visual",
    "test:e2e:all": "npm run test:e2e:smoke && npm run test:e2e:comprehensive && npm run test:e2e:visual",
    "test:e2e:android": "npx playwright test -c playwright.config.mjs --project=android --workers=2",
    "test:e2e:android:headed": "npx playwright test -c playwright.config.mjs --project=android --headed --workers=1",
    "test:e2e:android:screenshots": "npx playwright test -c playwright.config.mjs --project=android --workers=2 --reporter=list",
    "test:release-gate": "node scripts/release-gate-run.mjs",
    "test:release-gate:360": "npx playwright test -c playwright.config.mjs --project=release-gate --workers=4 --reporter=list",
    "test:release-gate:412": "npx playwright test -c playwright.config.mjs --project=release-gate-pixel7 --workers=4 --reporter=list",
    "test:release-gate:summary": "node scripts/release-gate-summary.mjs",
    "lint": "eslint src --report-unused-disable-directives --max-warnings 0",
    "preview": "vite preview",
    "test": "vitest run"
  },
  "dependencies": {
    "@capacitor-community/contacts": "^7.1.0",
    "@capacitor/app": "^8.0.0",
    "@capacitor/core": "^8.0.0",
    "@capacitor/geolocation": "^8.0.0",
    "@capacitor/haptics": "^8.0.2",
    "@capacitor/status-bar": "^8.0.2",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-avatar": "^1.1.10",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slot": "^1.0.2",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.1.5",
    "@tanstack/react-query": "^5.90.16",
    "axios": "^1.15.0",
    "browser-image-compression": "^2.0.2",
    "class-variance-authority": "^0.7.0",
    "clsx": "^2.1.0",
    "dompurify": "^3.3.3",
    "i18next-browser-languagedetector": "^8.2.0",
    "i18next-chained-backend": "^4.6.3",
    "i18next-http-backend": "^3.0.2",
    "i18next-localstorage-backend": "^4.3.1",
    "lucide-react": "^0.368.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-helmet-async": "^3.0.0",
    "react-i18next": "^16.0.0",
    "react-icons": "^5.5.0",
    "react-router-dom": "^6.22.3",
    "react-transition-group": "^4.4.5",
    "socket.io-client": "^4.8.3",
    "tailwind-merge": "^2.2.2"
  },
  "devDependencies": {
    "@capacitor/android": "^8.1.0",
    "@capacitor/cli": "^8.1.0",
    "@capacitor/ios": "^8.1.0",
    "@playwright/test": "^1.58.2",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react-swc": "^3.11.0",
    "autoprefixer": "^10.4.19",
    "eslint": "^8.57.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.0",
    "eslint-plugin-react-refresh": "^0.4.6",
    "jsdom": "^27.2.0",
    "postcss": "^8.4.38",
    "tailwindcss": "^3.4.3",
    "terser": "^5.44.1",
    "vite": "^6.4.2",
    "vitest": "^4.0.15"
  },
  "overrides": {
    "@xmldom/xmldom": "^0.8.12"
  }
}
