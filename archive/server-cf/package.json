{
  "name": "mhub-server-cf",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply mhub_db --local",
    "db:migrate:remote": "wrangler d1 migrations apply mhub_db --remote",
    "db:seed:local": "wrangler d1 execute mhub_db --local --file=./migrations/seed.sql",
    "db:seed:remote": "wrangler d1 execute mhub_db --remote --file=./migrations/seed.sql",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.14",
    "jose": "^5.9.6",
    "nanoid": "^5.0.9"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "typescript": "^5.7.2",
    "wrangler": "^3.99.0"
  }
}
