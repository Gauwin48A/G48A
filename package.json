{
  "name": "mhub-workspace",
  "private": true,
  "version": "1.0.0",
  "scripts": {
    "dev": "node server/scripts/workspace/dev.js",
    "doctor": "node server/scripts/workspace/doctor.js",
    "check:repo-structure": "node server/scripts/workspace/check-repo-structure.js",
    "continuous:run": "node server/scripts/workspace/continuous-improvement.js",
    "continuous:run:quick": "node server/scripts/workspace/continuous-improvement.js --mode=quick",
    "continuous:run:strict": "node server/scripts/workspace/continuous-improvement.js --mode=strict --fail-fast=true",
    "continuous:watch": "node server/scripts/workspace/continuous-improvement.js --mode=standard --watch=true --interval-seconds=300",
    "continuous:watch:strict": "node server/scripts/workspace/continuous-improvement.js --mode=strict --watch=true --interval-seconds=300 --fail-fast=true",
    "continuous:watch:strict:nonstop": "node server/scripts/workspace/continuous-improvement.js --mode=strict --watch=true --interval-seconds=300 --fail-fast=false",
    "implementation:safe": "node server/scripts/workspace/safe-e2e-implementation.js --mode=standard",
    "implementation:safe:dry-run": "node server/scripts/workspace/safe-e2e-implementation.js --mode=standard --dry-run=true",
    "implementation:safe:strict": "node server/scripts/workspace/safe-e2e-implementation.js --mode=strict --fail-fast=true --refresh-backup-evidence=true --enforce-ops-gate=true",
    "implementation:safe:watch": "node server/scripts/workspace/safe-e2e-implementation.js --mode=strict --watch=true --interval-seconds=300 --fail-fast=false --refresh-backup-evidence=true --enforce-ops-gate=true",
    "proactive:test": "node server/scripts/workspace/proactive-check.js",
    "seo:generate": "node server/scripts/workspace/generate-seo-artifacts.js",
    "changelog:generate": "node server/scripts/workspace/generate-changelog.js",
    "release:gate": "npm run check:repo-structure && npm run proactive:test && npm run doctor && npm run ops:gate:strict:enforced",
    "check:proactive-workflow-contract": "node server/scripts/workspace/check-proactive-workflow-contract.js",
    "proactive:verify-alert-lifecycle": "node server/scripts/workspace/verify-proactive-alert-lifecycle.js",
    "proactive:verify-alert-lifecycle:auto-token": "node server/scripts/workspace/run-proactive-alert-lifecycle.js",
    "check:testcase-catalog": "node server/scripts/workspace/check-testcase-catalog.js",
    "check:no-secrets": "node server/scripts/workspace/check-no-secrets.js",
    "check:hardcoded-strings": "node server/scripts/workspace/check-hardcoded-strings.js",
    "check:ui-screenshots": "node server/scripts/workspace/check-ui-screenshots.js",
    "check:backup-toolchain": "node server/scripts/workspace/check-backup-toolchain.js",
    "audit:worktree": "node server/scripts/workspace/worktree-risk-audit.js",
    "cleanup:checklist": "node server/scripts/workspace/release-cleanup-checklist.js",
    "backup:evidence:refresh": "node server/scripts/workspace/refresh-backup-evidence.js",
    "backup:evidence:refresh:force": "node server/scripts/workspace/refresh-backup-evidence.js --force=true",
    "ops:gate": "node server/scripts/workspace/operations-gate.js",
    "ops:gate:strict": "node server/scripts/workspace/operations-gate.js --strict=true",
    "ops:gate:strict:enforced": "node server/scripts/workspace/operations-gate.js --strict=true --enforce-failover=true --enforce-backup=true --enforce-foundation=true",
    "footprint:report": "node server/scripts/workspace/footprint-report.js",
    "footprint:guard": "node server/scripts/workspace/guard-footprint.js",
    "footprint:guard:strict": "node server/scripts/workspace/guard-footprint.js --strict-tracked",
    "footprint:guard:tracked-deps": "node server/scripts/workspace/guard-tracked-deps.js",
    "lines:report": "node server/scripts/workspace/line-budget.js --mode=report",
    "lines:guard": "node server/scripts/workspace/line-budget.js --mode=guard",
    "validate:locales": "node server/scripts/workspace/validate-locales.js",
    "optimize:locales": "node server/scripts/workspace/optimize-locales.js",
    "optimize:run": "node server/scripts/workspace/optimize-pipeline.js",
    "optimize:run:aggressive": "node server/scripts/workspace/optimize-pipeline.js --aggressive",
    "optimize:run:aggressive:with-install": "node server/scripts/workspace/optimize-pipeline.js --aggressive --with-install",
    "optimize:footprint": "node server/scripts/workspace/optimize-footprint.js",
    "optimize:footprint:aggressive": "node server/scripts/workspace/optimize-footprint.js --aggressive",
    "optimize:footprint:aggressive:remove-deps": "node server/scripts/workspace/optimize-footprint.js --aggressive --confirm-remove-deps",
    "install:client": "node server/scripts/workspace/safe-install.js client",
    "install:server": "node server/scripts/workspace/safe-install.js server",
    "install:all": "npm run install:client && npm run install:server",
    "install:all:prod": "node server/scripts/workspace/safe-install.js client --prod && node server/scripts/workspace/safe-install.js server --prod",
    "dedupe:client": "npm dedupe --prefix client",
    "dedupe:server": "npm dedupe --prefix server",
    "dedupe:all": "npm run dedupe:client && npm run dedupe:server",
    "install:all:optimized": "npm run install:all && npm run dedupe:all && npm run footprint:report"
  },
  "dependencies": {
    "@simplewebauthn/server": "^13.3.0",
    "express-slow-down": "^3.1.0"
  }
}

