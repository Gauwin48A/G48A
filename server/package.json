{
  "name": "server",
  "version": "1.0.0",
  "main": "src/index.js",
  "scripts": {
    "start": "npm run preflight:schema && node scripts/start-prod.js",
    "dev": "nodemon",
    "test": "node scripts/run-jest.js --runInBand --openHandlesTimeout=10000 --silent",
    "test:critical-paths": "node scripts/run-jest.js --runInBand --silent tests/critical_paths.integration.test.js",
    "test:e2e:journeys": "node scripts/run-jest.js --runInBand --silent tests/e2e/top10_user_journeys.e2e.test.js",
    "test:auth:integration": "node scripts/run-jest.js --runInBand --openHandlesTimeout=10000 --silent tests/auth.real.integration.test.js",
    "test:waf": "node scripts/run-jest.js --runInBand --silent tests/waf.enforcement.test.js",
    "preflight:schema": "node scripts/preflight-schema.js",
    "seed:sample-data": "node scripts/seed-sample-data.js",
    "check:schema-contract": "node scripts/check-schema-contract.js",
    "check:route-contract": "node scripts/check-route-contract.js",
    "check:foundation-contract": "node scripts/check-foundation-contract.js",
    "check:runtime-contract": "node scripts/probe-runtime-contract.js",
    "check:page-flow-contract": "node scripts/probe-page-flow-contract.js",
    "check:structure": "node scripts/check-folder-structure.js",
    "security:check": "npm audit --audit-level=high",
    "load:test:dry-run": "node tests/load/simple_load_runner.js --dry-run true",
    "load:test": "node tests/load/simple_load_runner.js",
    "readiness:probe-matrix": "node scripts/probe_readiness_matrix.js",
    "flags:simulate-rollout": "node scripts/simulate_flag_rollout.js",
    "failover:tabletop": "node scripts/run_failover_tabletop.js",
    "failover:active-active": "node scripts/run_active_active_orchestration.js",
    "failover:active-active:synthetic-execute": "node scripts/run_active_active_orchestration.js --mode=execute --synthetic-probe=true --settle-ms=0 --shift-steps=90:10,0:100 --traffic-command=\"echo SHIFT_A={WEIGHT_A} SHIFT_B={WEIGHT_B}\" --require-safety-gate=false",
    "failover:active-active:dependency-gate": "node scripts/run_active_active_dependency_gate.js",
    "failover:active-active:dependency-gate:skip-probe": "node scripts/run_active_active_dependency_gate.js --skip-probe=true",
    "failover:db-queue-audit": "node scripts/run_failover_db_queue_audit.js",
    "risk:telemetry:export": "node scripts/export_risk_telemetry.js",
    "backup:drill": "node scripts/run_backup_drill.js",
    "backup:drill:ps1": "powershell -ExecutionPolicy Bypass -File .\\scripts\\run_backup_drill.ps1",
    "auth:verify": "node scripts/verify_auth_rollout.js",
    "migrate:auth-sessions": "node scripts/ops/run_migration.js database/migrations/fix_user_sessions_user_id_type.sql",
    "migrate:profiles-backfill": "node scripts/ops/run_migration.js database/migrations/backfill_missing_profiles.sql",
    "migrate:posts-expiry-backfill": "node scripts/ops/run_migration.js database/migrations/backfill_active_post_expiry.sql",
    "migrate:security": "node scripts/ops/run_sec_migration.js",
    "migrate:051-feature-tables": "node scripts/ops/run_migration.js database/migrations/051_feature_tables.sql",
    "migrate:052-schema-reconciliation": "node scripts/ops/run_migration.js database/migrations/052_schema_reconciliation.sql",
    "migrate:053-reviews-users": "node scripts/ops/run_migration.js database/migrations/053_reviews_users_columns.sql",
    "migrate:054-marketplace-indexes": "node scripts/ops/run_migration.js database/migrations/054_marketplace_indexes.sql",
    "migrate:055-login-flow": "node scripts/ops/run_migration.js database/migrations/055_login_flow_columns.sql",
    "auth:e2e:login-flow": "bash scripts/auth-flow-e2e.sh",
    "seed:profiles": "node scripts/ops/seed-profiles.js",
    "build:client": "cd ../client && npm install && npm run build"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1090.0",
    "@simplewebauthn/server": "^13.3.0",
    "argon2": "^0.44.0",
    "axios": "^1.15.0",
    "bcrypt": "^6.0.0",
    "bullmq": "^5.80.9",
    "cloudinary": "^2.9.0",
    "compression": "^1.8.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "express-rate-limit": "^8.3.2",
    "express-slow-down": "^3.1.0",
    "express-validator": "^7.3.1",
    "firebase-admin": "^14.2.0",
    "geoip-lite": "^1.4.10",
    "helmet": "^8.1.0",
    "hpp": "^0.2.3",
    "ioredis": "^5.8.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.1.1",
    "node-cache": "^5.1.2",
    "node-cron": "^4.2.1",
    "nodemailer": "^9.0.3",
    "pg": "^8.16.3",
    "pino": "^10.1.0",
    "pusher": "^5.3.2",
    "qrcode": "^1.5.4",
    "request-ip": "^3.3.0",
    "sanitize-html": "^2.17.2",
    "sharp": "^0.34.5",
    "socket.io": "^4.8.3",
    "speakeasy": "^2.0.0",
    "web-push": "^3.6.7",
    "zxcvbn": "^4.4.2"
  },
  "devDependencies": {
    "jest": "^30.2.0",
    "nodemon": "^3.1.14",
    "supertest": "^7.1.4"
  },
  "overrides": {
    "lodash": "^4.17.24",
    "path-to-regexp@8.x": "8.4.0",
    "picomatch@2.x": "2.3.2",
    "picomatch@4.x": "4.0.4",
    "brace-expansion@1.x": "1.1.13",
    "brace-expansion@2.x": "2.0.3",
    "brace-expansion@4.x": "5.0.5",
    "nodemon": {
      "brace-expansion": "5.0.5"
    },
    "socket.io-parser": "4.2.6"
  }
}
